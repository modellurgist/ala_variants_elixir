<.header>
  <.link
    navigate={~p"/products"}
    class="text-sm font-medium leading-6 text-stone-500 hover:text-stone-800"
  >
    <.icon name="hero-arrow-left-solid" class="h-3 w-3" /> Back to products
  </.link>
  <:actions>
    <.link patch={~p"/products/#{@product}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit product</.button>
    </.link>
  </:actions>
</.header>

<div class="mt-6 grid gap-10 rounded-2xl border border-stone-200 bg-white p-8 shadow-sm md:grid-cols-2">
  <div class="aspect-square rounded-xl bg-stone-100 p-10">
    <img
      class="h-full w-full rounded-xl object-cover"
      src={@product.thumbnail}
      title={@product.name}
      alt={@product.name}
    />
  </div>
  <div class="flex flex-col justify-center">
    <h1 class="pb-2 text-3xl font-semibold tracking-tight">{@product.name}</h1>
    <div class="pb-8 text-stone-500">{@product.description}</div>
    <div class="pb-4 text-4xl font-semibold tabular-nums">{Money.new(@product.amount)}</div>
    <div class="text-sm text-stone-500">{@product.stock} remaining</div>
  </div>
</div>

<GoodDeal.Components.Panes.only_on current={@live_action} name={:edit}>
  <.modal
    id="product-modal"
    show
    on_cancel={JS.patch(~p"/products/#{@product}")}
  >
    <.record_form
      id="product-form"
      form={@form}
      fields={@form_text.fields}
      title={@page_title}
      subtitle={@form_text.subtitle}
      submit={@form_text.submit}
      saving={@form_text.saving}
      on_validate="validate_product"
      on_submit="save_product"
    />
  </.modal>
</GoodDeal.Components.Panes.only_on>
