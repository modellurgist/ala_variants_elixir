<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/">
        <img src={~p"/images/logo.svg"} width="36" />
      </a>
      <p class="font-semibold">Good Deal</p>
    </div>
    <nav class="flex items-center gap-4 font-semibold leading-6 text-zinc-900">
      <.link navigate={~p"/products"} class="hover:text-zinc-700">Products</.link>
      <.link navigate={~p"/cart"} class="hover:text-zinc-700">Cart</.link>
      <.link navigate={~p"/portal"} class="hover:text-zinc-700">B2B portal</.link>
    </nav>
  </div>
</header>
<main class="px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-4xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
