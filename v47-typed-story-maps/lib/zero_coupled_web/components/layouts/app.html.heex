<header class="sticky top-0 z-10 border-b border-stone-200 bg-white/90 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-1 px-6">
    <a href="/" class="mr-auto text-base font-bold tracking-tight sm:text-lg">
      Zero<span class="text-brand-700">Coupled</span>
    </a>
    <a
      href="/products"
      class="whitespace-nowrap rounded-lg px-2 py-2 text-sm font-medium text-stone-600 sm:px-3 hover:bg-stone-100 hover:text-stone-900"
    >
      Products
    </a>
    <a
      href="/portal"
      class="whitespace-nowrap rounded-lg px-2 py-2 text-sm font-medium text-stone-600 sm:px-3 hover:bg-stone-100 hover:text-stone-900"
    >
      Bulk orders
    </a>
    <a
      href="/cart"
      class="ml-1 inline-flex items-center gap-2 whitespace-nowrap rounded-lg bg-stone-900 px-3 py-2 text-sm font-medium text-white hover:bg-stone-700"
    >
      <.icon name="hero-shopping-bag" class="hidden h-4 w-4 sm:inline-block" /> Cart
    </a>
  </nav>
</header>
<main class="mx-auto max-w-6xl px-6 py-10">
  <.flash_group flash={@flash} />
  {@inner_content}
</main>
